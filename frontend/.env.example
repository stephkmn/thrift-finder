# Copy to .env (never commit .env). No secrets belong in frontend env files:
# every VITE_* variable is bundled into the public JavaScript.

# true  = use the in-browser mock API (no backend needed)
# false = call the FastAPI backend through the Vite dev proxy (/api -> http://localhost:8000)
VITE_USE_MOCKS=true

# Fake network latency for mock responses, in milliseconds
VITE_MOCK_DELAY_MS=600
