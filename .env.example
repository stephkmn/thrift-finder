# Copy to .env (gitignored) and fill in real values. Never commit secrets.
# See docs/PHASE2_SPRINT_PLAN.md §4.5 for the authoritative env-var list.

# --- eBay Browse API (Member B) ---
# Obtain from https://developer.ebay.com/ ; OAuth client-credentials flow.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- Data source selection ---
# `ebay`  = call the live Browse API (requires the two secrets above)
# `local` = read from the fallback dataset in data/ (good default for dev + CI)
DATA_SOURCE=local

# --- ML model selection (Member A) ---
# Hugging Face repo id. Primary: patrickjohncyh/fashion-clip
# Baseline:                openai/clip-vit-base-patch32
MODEL_NAME=patrickjohncyh/fashion-clip
